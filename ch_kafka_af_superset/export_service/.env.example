# Superset (только метаданные / sync манифестов)
# В Docker-сети стека: http://superset:8088 (или http://superset2:8088 в docker-compose_af.yml)
# С хоста / внешнего IP: http://192.168.14.226:8088
SUPERSET_URL=http://superset:8088
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin

# ClickHouse (выгрузка данных)
CLICKHOUSE_HOST=clickhouse01
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=bdm

# Runtime (внутри контейнера пути переопределяются compose)
MANIFESTS_DIR=manifests
EXPORT_DIR=data/exports
CSV_DELIMITER=;
DRY_RUN=false

# Порт публикации на хосте (для compose)
EXPORT_SERVICE_PORT=8099
